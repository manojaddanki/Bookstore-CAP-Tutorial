{
  "name": "bookstore",
  "version": "1.0.0",
  "description": "Welcome to your new CAP project.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch-bookstore-listview": "cds watch --open bookstorelistview/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-library": "cds watch --open library/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-authors-listview": "cds watch --open authorslistview/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
   "cds": { "requires": {
   "db": {
      "kind": "sqlite",
      "credentials": { "url": "db.sqlite" } 
   }
   },
   "auth":{
    "kind":"mocked",
    "users":{
      "alice":{
        "password":"123",
        "roles":[
          "admin"
        ]
      },
      "bob":{
        "password":"321",
        "roles":[
          "user-that-can-call-actions",
          "only-read-access"
        ]
      }
    }
   }
  },

  "dependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds": "^10.1.1",
    "@sap/cds-common-content": "^3.2.0"
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "cds-plugin-ui5": "^0.17.0",
    "@cap-js/cds-typer": ">=0.1"
  },
  "sapux": [
    "app/bookstore-listview",
    "app/project1",
    "app/library",
    "app/authors-listview"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
